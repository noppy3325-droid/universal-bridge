<Window x:Class="UniversalControl.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Universal Bridge" Icon="Assets/app.ico" Width="1180" Height="820" MinWidth="1030" MinHeight="710" WindowStartupLocation="CenterScreen" Background="{DynamicResource PageBg}" FontFamily="Segoe UI, Yu Gothic UI" FontSize="14" Closing="OnClosing">
  <Grid Background="{DynamicResource PageBg}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <Grid Margin="20,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><Image Source="Assets/app-icon.png" Width="48" Height="48" HorizontalAlignment="Left" Stretch="Uniform"/><TextBlock Text="Universal Bridge" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,3"/><TextBlock Text="WINDOWS  ×  iPad" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,38,0,0">
          <Button x:Name="DashboardNav" Content="{DynamicResource L000}" Tag="DashboardPage" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,0,0,9"/>
          <Button x:Name="LayoutNav" Content="{DynamicResource L001}" Tag="LayoutPage" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,0,0,9"/>
          <Button x:Name="InputNav" Content="{DynamicResource L002}" Tag="InputPage" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,0,0,9"/>
          <Button x:Name="ClipboardNav" Content="{DynamicResource ClipboardHeading}" Tag="ClipboardPage" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,0,0,9"/>
          <Button x:Name="SettingsNav" Content="{DynamicResource L003}" Tag="SettingsPage" Click="Navigate" HorizontalContentAlignment="Left"/>
        </StackPanel>
        <StackPanel Grid.Row="2"><TextBlock Text="{DynamicResource L004}" FontSize="12" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="AppVersionLabel" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="32,28,32,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,20"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ComboBox x:Name="LanguageCombo" Width="154" Margin="0,0,12,0" AutomationProperties.Name="{DynamicResource LanguageLabel}" ToolTip="{DynamicResource LanguageLabel}" SelectionChanged="ChangeLanguage"/><Button x:Name="ThemeButton" Content="{DynamicResource L005}" Click="ToggleTheme" Padding="12,7"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource L006}" FontSize="13" Foreground="{DynamicResource Muted}"/><TextBlock Text="{DynamicResource BluetoothSubtitle}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel></DockPanel>
      <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,10">
        <Grid>
          <StackPanel x:Name="DashboardPage">
            <TextBlock Text="{DynamicResource L007}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L008}" Foreground="{DynamicResource Muted}" Margin="0,8,0,20"/>
            <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="BLUETOOTH HID" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="BluetoothStatus" Text="{DynamicResource L009}" FontSize="21" FontWeight="SemiBold" Margin="0,12,0,5"/><TextBlock x:Name="AdapterStatus" Text="{DynamicResource L010}" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="{DynamicResource L011}" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="PeerStatus" Text="{DynamicResource L012}" FontSize="21" FontWeight="SemiBold" Margin="0,12,0,5"/><TextBlock x:Name="SubscriptionStatus" Text="{DynamicResource L013}" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource L014}" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="InputTarget" Text="Windows" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,12,0,5"/><TextBlock x:Name="InputReason" Text="{DynamicResource L015}" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="{DynamicResource L016}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L017}" Foreground="{DynamicResource Muted}" Margin="0,10,0,17"/>
              <WrapPanel><Button x:Name="StartButton" Content="{DynamicResource L018}" Style="{StaticResource PrimaryButton}" Click="StartHid" Margin="0,0,10,0"/><Button x:Name="StopButton" Content="{DynamicResource L019}" Click="StopHid"/><Button Content="{DynamicResource L020}" Click="OpenBluetooth" Margin="10,0,0,0"/></WrapPanel>
              <TextBlock Text="{DynamicResource L021}" Margin="0,22,0,7"/><ComboBox x:Name="PeerCombo" SelectionChanged="PeerChanged" AutomationProperties.Name="{DynamicResource L022}"/>
              <Button x:Name="SwitchButton" Content="{DynamicResource L023}" Click="SwitchInput" HorizontalAlignment="Left" Margin="0,15,0,0"/>
              <TextBlock x:Name="ActivationShortcutLabel" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,12,0,0"/>
              <TextBlock x:Name="DashboardReturnShortcut" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
            </StackPanel></Border>
            <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="18" Margin="0,18,0,0"><StackPanel><TextBlock Text="{DynamicResource L024}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L025}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="LayoutPage" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource L026}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L027}" Foreground="{DynamicResource Muted}" Margin="0,8,0,20"/>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock x:Name="EdgeStatusLabel" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,0,0,8"/>
              <CheckBox x:Name="AutoSwitchCheck" Content="{DynamicResource L035}" Click="SaveControls"/>
              <CheckBox x:Name="ReturnAtEdgeCheck" Content="{DynamicResource ReturnAtEdgeLabel}" Click="SaveControls"/>
              <TextBlock Text="{DynamicResource ReturnAtEdgeHelp}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,10"/>
              <WrapPanel><TextBlock Text="{DynamicResource ReturnSizeLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="VirtualWidthBox" Width="65" AutomationProperties.Name="{DynamicResource ReturnWidthLabel}" LostKeyboardFocus="CommitReturnSize" KeyDown="ReturnSizeKeyDown"/><TextBlock Text=" × " VerticalAlignment="Center"/><TextBox x:Name="VirtualHeightBox" Width="65" AutomationProperties.Name="{DynamicResource ReturnHeightLabel}" LostKeyboardFocus="CommitReturnSize" KeyDown="ReturnSizeKeyDown"/></WrapPanel>
              <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><ComboBox x:Name="MonitorCombo" SelectionChanged="LayoutChanged" AutomationProperties.Name="{DynamicResource L028}" Margin="0,0,12,0"/><ComboBox x:Name="EdgeCombo" Grid.Column="1" SelectionChanged="LayoutChanged" AutomationProperties.Name="{DynamicResource L029}"><ComboBoxItem Content="{DynamicResource L030}"/><ComboBoxItem Content="{DynamicResource L031}"/><ComboBoxItem Content="{DynamicResource L032}"/><ComboBoxItem Content="{DynamicResource L033}"/></ComboBox></Grid>
              <Canvas x:Name="LayoutCanvas" Height="340" Background="{DynamicResource AccentSoft}" Margin="0,20,0,12" ClipToBounds="True" SizeChanged="LayoutSizeChanged"/>
              <TextBlock Text="{DynamicResource L034}" Foreground="{DynamicResource Muted}" FontSize="12"/>
              <TextBlock Text="{DynamicResource EdgeWaitLabel}" Margin="0,6,0,0"/>
              <Slider x:Name="EdgeDwellSlider" Minimum="150" Maximum="1500" TickFrequency="50" IsSnapToTickEnabled="True" SmallChange="50" LargeChange="150" ValueChanged="LayoutSliderChanged" Margin="0,8" AutomationProperties.Name="{DynamicResource EdgeWaitLabel}"/>
              <TextBlock Text="{DynamicResource L036}" Margin="0,10,0,0"/><Slider x:Name="PortalStartSlider" Minimum="0" Maximum="0.8" TickFrequency="0.05" ValueChanged="LayoutSliderChanged" Margin="0,8"/>
              <TextBlock Text="{DynamicResource L037}"/><Slider x:Name="PortalEndSlider" Minimum="0.2" Maximum="1" TickFrequency="0.05" ValueChanged="LayoutSliderChanged" Margin="0,8"/>
              <TextBlock x:Name="PortalLabel" Foreground="{DynamicResource Muted}" FontSize="12"/>
            </StackPanel></Border>
            <TextBlock Text="{DynamicResource L038}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,16,0,0"/>
          </StackPanel>
          <StackPanel x:Name="InputPage" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource L039}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L040}" Foreground="{DynamicResource Muted}" Margin="0,8,0,20"/>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="{DynamicResource L041}" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="MouseValue" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
              <WrapPanel Margin="0,10,0,0"><Button Content="− 0.01" Tag="-0.01" Click="StepMouseSensitivity" Padding="10,6"/><TextBox x:Name="MouseSensitivityBox" Width="80" Margin="10,0" TextAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource L042}" LostKeyboardFocus="CommitMouseSensitivity" KeyDown="MouseSensitivityKeyDown"/><Button Content="＋ 0.01" Tag="0.01" Click="StepMouseSensitivity" Padding="10,6"/><TextBlock Text="{DynamicResource L043}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="12,0,0,0"/></WrapPanel>
              <Slider x:Name="MouseSlider" Minimum="0.02" Maximum="4" TickFrequency="0.01" IsSnapToTickEnabled="True" SmallChange="0.01" LargeChange="0.1" ValueChanged="InputSliderChanged" Margin="0,12,0,10"/>
              <CheckBox x:Name="RawMouseCheck" Content="{DynamicResource L044}" Click="SaveControls"/>
              <CheckBox x:Name="FastPointerCheck" Content="{DynamicResource FastPointerLabel}" Click="SaveControls"/>
              <TextBlock Text="{DynamicResource FastPointerHelp}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,12"/>
              <TextBlock x:Name="MouseModeLabel" Foreground="{DynamicResource Muted}" FontSize="12"/>
              <TextBlock Text="{DynamicResource L045}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,22"/>
              <TextBlock Text="{DynamicResource L046}" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ScrollValue" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/><Slider x:Name="ScrollSlider" Minimum="0.1" Maximum="4" ValueChanged="InputSliderChanged" Margin="0,12,0,22"/>
              <TextBlock Text="{DynamicResource TouchpadScrollLabel}" FontSize="17" FontWeight="SemiBold"/>
              <WrapPanel Margin="0,10,0,0"><Button Content="− 0.25" Tag="-0.25" Click="StepTouchpadSensitivity" Padding="10,6"/><TextBox x:Name="TouchpadSensitivityBox" Width="80" Margin="10,0" TextAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource TouchpadScrollLabel}" LostKeyboardFocus="CommitTouchpadSensitivity" KeyDown="TouchpadSensitivityKeyDown"/><Button Content="＋ 0.25" Tag="0.25" Click="StepTouchpadSensitivity" Padding="10,6"/><Button Content="{DynamicResource RecommendedScroll}" Click="ResetTouchpadSensitivity" Margin="12,0,0,0" Padding="10,6"/></WrapPanel>
              <Slider x:Name="TouchpadScrollSlider" Minimum="0.25" Maximum="12" TickFrequency="0.25" IsSnapToTickEnabled="True" SmallChange="0.25" LargeChange="1" AutomationProperties.Name="{DynamicResource TouchpadScrollLabel}" ValueChanged="InputSliderChanged" Margin="0,12,0,8"/>
              <TextBlock Text="{DynamicResource TouchpadScrollHelp}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,22"/>
              <TextBlock Text="{DynamicResource L047}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L048}" Foreground="{DynamicResource Muted}" Margin="0,8,0,18"/>
              <TextBlock Text="{DynamicResource L049}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <CheckBox x:Name="TouchpadCheck" Content="{DynamicResource L050}" Click="SaveControls"/>
              <TextBlock x:Name="TouchpadStatusLabel" Foreground="{DynamicResource Muted}" FontSize="12"/>
              <TextBlock Text="{DynamicResource L051}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,8"/>
              <TextBlock Text="{DynamicResource L052}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,10"/>
              <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource L053}" VerticalAlignment="Center"/><ComboBox x:Name="SwipeLeftCombo" Grid.Column="1" SelectionChanged="GestureMappingChanged" AutomationProperties.Name="{DynamicResource L054}" Margin="0,3"/>
                <TextBlock Text="{DynamicResource L055}" Grid.Row="1" VerticalAlignment="Center"/><ComboBox x:Name="SwipeRightCombo" Grid.Row="1" Grid.Column="1" SelectionChanged="GestureMappingChanged" AutomationProperties.Name="{DynamicResource L056}" Margin="0,3"/>
                <TextBlock Text="{DynamicResource L057}" Grid.Row="2" VerticalAlignment="Center"/><ComboBox x:Name="SwipeUpCombo" Grid.Row="2" Grid.Column="1" SelectionChanged="GestureMappingChanged" AutomationProperties.Name="{DynamicResource L058}" Margin="0,3"/>
                <TextBlock Text="{DynamicResource L059}" Grid.Row="3" VerticalAlignment="Center"/><ComboBox x:Name="SwipeDownCombo" Grid.Row="3" Grid.Column="1" SelectionChanged="GestureMappingChanged" AutomationProperties.Name="{DynamicResource L060}" Margin="0,3"/>
              </Grid>
              <TextBlock Text="{DynamicResource L061}" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="{DynamicResource L062}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,10"/>
              <CheckBox x:Name="IPadShortcutsCheck" Content="{DynamicResource IPadShortcutsLabel}" Click="SaveControls"/>
              <TextBlock Text="{DynamicResource IPadShortcutsHelp}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,10"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource L063}" VerticalAlignment="Center"/><ComboBox x:Name="ActivateModsCombo" Grid.Column="1" AutomationProperties.Name="{DynamicResource L064}" Margin="0,3,8,3"/><ComboBox x:Name="ActivateKeyCombo" Grid.Column="2" AutomationProperties.Name="{DynamicResource L065}" Margin="0,3"/>
                <TextBlock Text="{DynamicResource L066}" Grid.Row="1" VerticalAlignment="Center"/><ComboBox x:Name="ReturnModsCombo" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="{DynamicResource L067}" Margin="0,3,8,3"/><ComboBox x:Name="ReturnKeyCombo" Grid.Row="1" Grid.Column="2" AutomationProperties.Name="{DynamicResource L068}" Margin="0,3"/>
                <TextBlock Text="{DynamicResource IPadHomeLabel}" Grid.Row="2" VerticalAlignment="Center"/><ComboBox x:Name="HomeModsCombo" Grid.Row="2" Grid.Column="1" AutomationProperties.Name="{DynamicResource IPadHomeLabel}" Margin="0,3,8,3"/><ComboBox x:Name="HomeKeyCombo" Grid.Row="2" Grid.Column="2" AutomationProperties.Name="{DynamicResource IPadHomeLabel}" Margin="0,3"/>
                <TextBlock Text="{DynamicResource IPadSearchLabel}" Grid.Row="3" VerticalAlignment="Center"/><ComboBox x:Name="SearchModsCombo" Grid.Row="3" Grid.Column="1" AutomationProperties.Name="{DynamicResource IPadSearchLabel}" Margin="0,3,8,3"/><ComboBox x:Name="SearchKeyCombo" Grid.Row="3" Grid.Column="2" AutomationProperties.Name="{DynamicResource IPadSearchLabel}" Margin="0,3"/>
                <TextBlock Text="{DynamicResource IPadNextAppLabel}" Grid.Row="4" VerticalAlignment="Center"/><ComboBox x:Name="NextAppModsCombo" Grid.Row="4" Grid.Column="1" AutomationProperties.Name="{DynamicResource IPadNextAppLabel}" Margin="0,3,8,3"/><ComboBox x:Name="NextAppKeyCombo" Grid.Row="4" Grid.Column="2" AutomationProperties.Name="{DynamicResource IPadNextAppLabel}" Margin="0,3"/>
              </Grid>
              <TextBlock x:Name="AdditionalShortcutsHeading" Text="{DynamicResource AdditionalShortcutsLabel}" FontWeight="SemiBold" Margin="0,18,0,8"/>
              <ItemsControl x:Name="AdditionalShortcutsList"><ItemsControl.ItemTemplate><DataTemplate>
                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Content="{Binding Label}" VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding ModifierOptions}" SelectedItem="{Binding SelectedModifier, Mode=TwoWay}" IsEnabled="{Binding Enabled}" Margin="0,0,8,0" AutomationProperties.Name="{Binding Label}"/>
                  <ComboBox Grid.Column="2" ItemsSource="{Binding KeyOptions}" SelectedItem="{Binding SelectedKey, Mode=TwoWay}" IsEnabled="{Binding Enabled}" AutomationProperties.Name="{Binding Label}"/>
                </Grid>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <TextBlock Text="{DynamicResource AdditionalShortcutsHelp}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,8"/>
              <WrapPanel Margin="0,10,0,8"><Button x:Name="ApplyShortcutsButton" Content="{DynamicResource L069}" Click="ApplyShortcuts"/><Button Content="{DynamicResource L070}" Click="DefaultShortcuts" Margin="10,0,0,0"/></WrapPanel>
              <TextBlock x:Name="ShortcutStatusLabel" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,15"/>
            </StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="ClipboardPage" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource ClipboardHeading}" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource ClipboardIntro}" Foreground="{DynamicResource Muted}" Margin="0,8,0,20"/>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="{DynamicResource ClipboardNetwork}" FontWeight="SemiBold"/>
              <Grid Margin="0,10,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="ClipboardAddressCombo" AutomationProperties.Name="{DynamicResource ClipboardNetwork}" SelectionChanged="ClipboardAddressChanged"/><Button x:Name="ClipboardRefreshButton" Grid.Column="1" Content="{DynamicResource ClipboardRefresh}" Click="RefreshClipboardAddresses" Margin="10,0,0,0" Padding="12,7"/></Grid>
              <WrapPanel><Button x:Name="ClipboardStartButton" Content="{DynamicResource ClipboardStart}" Click="StartClipboard" Style="{StaticResource PrimaryButton}"/><Button x:Name="ClipboardStopButton" Content="{DynamicResource ClipboardStop}" Click="StopClipboard" Margin="10,0,0,0"/></WrapPanel>
              <TextBlock x:Name="ClipboardStatus" Foreground="{DynamicResource Accent}" Margin="0,12,0,0"/>
              <TextBlock Text="{DynamicResource ClipboardFirewall}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
              <TextBlock Text="{DynamicResource ClipboardSetup}" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="{DynamicResource ClipboardSetupHelp}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,10"/>
              <DockPanel><Button x:Name="ClipboardCopySetup" DockPanel.Dock="Right" Content="{DynamicResource ClipboardCopyUrl}" Click="CopyClipboardLink" Padding="12,7" Margin="10,0,0,0"/><TextBox x:Name="ClipboardSetupUrl" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource ClipboardSetup}"/></DockPanel>
              <TextBlock x:Name="ClipboardIdentityName" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,4"/>
              <TextBlock Text="SHA-256" Foreground="{DynamicResource Muted}" FontSize="10"/>
              <TextBox x:Name="ClipboardFingerprint" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" BorderThickness="0" Background="Transparent" AutomationProperties.Name="SHA-256"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
              <TextBlock Text="{DynamicResource ClipboardConnect}" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="{DynamicResource ClipboardConnectHelp}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,10"/>
              <DockPanel><Button x:Name="ClipboardCopyShare" DockPanel.Dock="Right" Content="{DynamicResource ClipboardCopyUrl}" Click="CopyClipboardLink" Padding="12,7" Margin="10,0,0,0"/><TextBox x:Name="ClipboardShareUrl" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource ClipboardConnect}"/></DockPanel>
              <DockPanel Margin="0,12,0,4"><Button x:Name="ClipboardCodeButton" DockPanel.Dock="Right" Content="{DynamicResource ClipboardNewCode}" Click="RefreshClipboardCode" Padding="12,7"/><TextBlock x:Name="ClipboardCode" FontFamily="Consolas" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/></DockPanel>
              <TextBlock Text="{DynamicResource ClipboardCodeHelp}" Foreground="{DynamicResource Muted}" FontSize="12"/>
              <TextBlock Text="{DynamicResource ClipboardUseHelp}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,16,0,0"/>
            </StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource L073}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L074}" Foreground="{DynamicResource Muted}" Margin="0,8,0,20"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
              <TextBlock Text="{DynamicResource UpdateHeading}" FontSize="18" FontWeight="SemiBold"/>
              <CheckBox x:Name="AutoUpdateCheck" Content="{DynamicResource UpdateAutomatic}" Click="SaveUpdatePreference" Margin="0,10,0,4"/>
              <TextBlock Text="{DynamicResource UpdateHelp}" Foreground="{DynamicResource Muted}" FontSize="12"/>
              <TextBlock x:Name="UpdateStatus" Foreground="{DynamicResource Accent}" Margin="0,10,0,10" TextWrapping="Wrap"/>
              <WrapPanel><Button x:Name="CheckUpdateButton" Content="{DynamicResource UpdateCheck}" Click="CheckUpdateClicked"/><Button x:Name="InstallUpdateButton" Content="{DynamicResource UpdateInstall}" Click="InstallUpdateClicked" IsEnabled="False" Margin="10,0,0,0"/><Button Content="{DynamicResource UpdateReleases}" Click="OpenReleases" Margin="10,0,0,0"/></WrapPanel>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><CheckBox x:Name="TrayCheck" Content="{DynamicResource L075}" Click="SaveControls"/><CheckBox x:Name="ReconnectCheck" Content="{DynamicResource L076}" Click="SaveControls"/><CheckBox x:Name="AutostartCheck" Content="{DynamicResource L077}" Click="SaveControls"/><TextBlock Text="{DynamicResource L078}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource L079}" Click="ExportDiagnostics" Padding="12,7"/><TextBlock Text="{DynamicResource L080}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="ReportStats" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,10"/><TextBox x:Name="LogBox" Height="200" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" RequestBringIntoView="PreventOuterLogScroll"/><TextBlock x:Name="DataPathLabel" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,10,0,0"/></StackPanel></Border>
            <Button Content="{DynamicResource L081}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="ExitApplication"/>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="MessageText" Text="{DynamicResource L082}" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/><Button x:Name="ReturnButton" Grid.Column="1" Content="{DynamicResource L083}" Click="ReturnLocal" Padding="14,9"/></Grid></Border>
    </Grid>
  </Grid>
</Window>
